# Serves the current Fleeting release. tailscale serve terminates TLS and
# proxies to this listener on 127.0.0.1, so Caddy speaks plain HTTP.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/current
	# Generated from the build's _headers file by fleeting-deploy.sh
	import /srv/headers.caddy
	# The app uses hash routing, so /foryou is not a file. Send a typed
	# /foryou to the route. Other missing paths stay a plain 404, which the
	# service worker's stale-shell recovery depends on.
	redir /foryou /#/foryou
	file_server {
		hide _headers headers.caddy
	}
}
